# alias gitc='git commit -m "add"'
# alias gc='git commit -m "add"'
gitc() {
  if [[ -z "$1" ]] ; then
    com="add"
  else
    com="$@"
  fi
  git commit -m "$com"
}
gtc() {
  if [[ -z "$1" ]] ; then
    com="add"
  else
    com="$@"
  fi
  git commit -m "$com"
}
